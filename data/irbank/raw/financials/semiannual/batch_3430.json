    },
    {
      "key": "extraordinary_income",
      "label": "特別利益",
      "unit": "million_jpy",
      "note": "J-GAAP 固有。IFRS / US-GAAP 提出企業では null"
    },
    {
      "key": "extraordinary_loss",
      "label": "特別損失",
      "unit": "million_jpy",
      "note": "J-GAAP 固有。IFRS / US-GAAP 提出企業では null"
    },
    {
      "key": "total_assets",
      "label": "総資産",
      "unit": "million_jpy",
      "note": "四半期・半期モードでは full_year 行にのみ値が入る"
    },
    {
      "key": "net_assets",
      "label": "純資産",
      "unit": "million_jpy",
      "note": "四半期・半期モードでは full_year 行にのみ値が入る"
    },
    {
      "key": "total_liabilities",
      "label": "負債合計",
      "unit": "million_jpy",
      "note": "四半期・半期モードでは full_year 行にのみ値が入る"
    },
    {
      "key": "equity_ratio_computed",
      "label": "自己資本比率",
