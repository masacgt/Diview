      "unit": "percent"
    },
    {
      "key": "dividend_yield_high_adjusted",
      "label": "配当利回り(調整後・利回り最大)",
      "unit": "percent"
    },
    {
      "key": "dividend_yield_low_adjusted",
      "label": "配当利回り(調整後・利回り最小)",
      "unit": "percent"
    },
    {
      "key": "per_5y_avg",
      "label": "PER5年平均",
      "unit": "times",
      "note": "トップレベルスカラー (history[] 要素ではない)。直近5年の正の PER の単純平均。直近5年に正の PER が1つも無い場合のみ最新 PER にフォールバックするが、その条件下では最新 PER 自体が null/非正のため実質 null になる"
    }
